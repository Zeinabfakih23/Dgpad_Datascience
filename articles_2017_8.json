        "keywords": [
            "فلسطين",
            "إسرائيل",
            "أدب"
        ],
        "thumbnail": "https://alpha-ar-media.almayadeen.net/archive/image/2017/8/16/581ce551-ee17-4c39-8240-b4393f9c95c6.jpeg?v=3&width=1000",
        "video_duration": null,
