            "وفا سرايا",
            "تيلي سور",
            "قناة تيلي سور",
            "نستطيع",
            "Poder"
        ],
        "thumbnail": "https://alpha-ar-media.almayadeen.net/archive/image/2018/6/6/f5c82c26-f8cb-4d2a-b802-d9332a6da3c3.jpg?v=2&width=1000",
        "video_duration": null,
        "word_count": "440",
