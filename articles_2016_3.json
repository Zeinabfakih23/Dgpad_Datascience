        "postid": "729193",
        "title": "كيف تواجه المقاومة والدول النامية العقوبات؟",
        "url": "https://www.almayadeen.net/episodes/729193/_كيف-تواجه-المقاومة-والدول-النامية-العقوبات-",
        "keywords": [
            "المقاومة",
            "لعبة الأمم",
            "الدول النامية",
            "العقوبات الدولية",
            "Military"
        ],
        "thumbnail": "https://alpha-ar-media.almayadeen.net/archive/image/2016/3/9/8723ab09-643a-404c-8e8b-e3809cd85d9a.jpg?v=4&width=1000",
        "video_duration": "4343",
        "word_count": "354",
        "lang": "ar",
